{
  "name": "care_ccn_fe",
  "version": "0.1.0",
  "private": true,
  "description": "CARE app for sending and tracking referrals over the CCN (Beckn) network",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "start": "concurrently -n 'build,serve' -c 'green.bold,blue.bold' \"npm run build:watch\" \"npm run preview\"",
    "build:watch": "nodemon",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test:unit": "node --import tsx --test \"src/**/*.test.ts\"",
    "lint": "eslint ./src",
    "lint-fix": "eslint ./src --fix",
    "format": "prettier ./src --write",
    "sort-locales": "tsx scripts/sort-locales.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@tanstack/react-query": "^5.100.14",
    "@tanstack/react-router": "1.170.46",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.21",
    "lucide-react": "^1.17.0",
    "react-i18next": "^17.0.8",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0"
  },
  "peerDependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@originjs/vite-plugin-federation": "^1.4.1",
    "@tailwindcss/vite": "^4.3.0",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "@typescript-eslint/parser": "^8.32.1",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^9.1.2",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-i18next": "^6.1.1",
    "eslint-plugin-no-relative-import-paths": "^1.6.1",
    "eslint-plugin-prettier": "^5.4.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.1.0",
    "nodemon": "^3.1.9",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.14"
  }
}
